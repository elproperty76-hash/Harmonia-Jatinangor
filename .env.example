# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Destination email for lead & consultation notifications.
ADMIN_EMAIL="el.property76@gmail.com"

# Optional SMTP settings for direct server-side email delivery via Nodemailer.
# If omitted, inquiries are persisted on server, broadcast in real-time via WebSocket,
# and provided with instant mailto & WhatsApp relay links.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Harmonia Student House <noreply@harmoniajatinangor.id>"
